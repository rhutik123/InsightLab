# InsightLab Environment Variable Reference
# config/settings.py reads environment variables from your OS / terminal session
# (it does not automatically load a .env file; set these in PowerShell, shell, or host config).
# Never commit real secret keys to source control.
# Database: SQLite (db.sqlite3) is configured by default; PostgreSQL is not yet configured.

# Set to False in production
DJANGO_DEBUG=True

# Required when DJANGO_DEBUG=False (generate a long random string)
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key

# Comma-separated list of allowed hostnames
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
