# InsightLab Environment Configuration
# Copy this file to .env and set real values before deploying to production.
# Never commit your .env file or real secret keys to GitHub.

# Set to False in production
DJANGO_DEBUG=True

# Required when DJANGO_DEBUG=False (generate a long random string)
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key

# Comma-separated list of allowed hostnames
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Optional PostgreSQL settings (SQLite is used by default in config/settings.py)
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=insightlab
# DB_USER=insightlab_user
# DB_PASSWORD=replace-with-db-password
# DB_HOST=localhost
# DB_PORT=5432
